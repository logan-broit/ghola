# Copy to .env and adjust. All values have sensible defaults in
# docker-compose.yml, so this file is optional for a minimal "up".

# Postgres
POSTGRES_USER=memory_api
POSTGRES_PASSWORD=dev
POSTGRES_DB=memories
POSTGRES_PORT=5432

# Embedding dim used by ${EMBEDDING_DIM} placeholder in the episodic
# migration. Must match what your embedding provider actually returns.
EMBEDDING_DIM=1024

# Embedding service (openai-compatible). Default: the TEI container
# in compose serving Qwen3-Embedding-0.6B. Override to point at a
# different service (e.g. Together.ai, a host-side llama-embed) if
# you prefer. The `--profile stub` path swaps in a deterministic
# Python hash-stub for fast/unit-style runs.
EMBEDDING_URL=http://guild:8082
EMBEDDING_MODEL=qwen3-embedding
EMBEDDING_API_KEY=

# Chapterhouse
CHAPTERHOUSE_PORT=8080
DEFAULT_USER_UUID=00000000-0000-0000-0000-000000000001

# Ghola local daemon (--profile all)
GHOLA_PORT=7421
CHAPTERHOUSE_API_KEY=
ENCODING_INTERVAL=5m

# Mentat (predictive-replay) service
MENTAT_PORT=8084
# MENTAT_URL=http://mentat:8084
