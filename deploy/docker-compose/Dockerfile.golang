# Multi-stage build for every Go binary in the monorepo: ghola,
# ghola-mcp, import-logs, ch-web (cmd/...) and ch-api, ch-init,
# ch-worker, ch-backfill-sessions (chapterhouse/cmd/...).
# Build context is the ghola monorepo root. Compose selects the binary
# per service via entrypoint:. Migrations are embedded (go:embed in
# chapterhouse/internal/repository), so nothing else ships on disk.
FROM golang:1.25-alpine AS build

WORKDIR /src
RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /out/ ./cmd/... ./chapterhouse/cmd/...

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/ /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/ghola"]
