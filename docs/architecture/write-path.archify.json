  "cards": [
    { "dot": "emerald", "title": "Never lose a write", "items": [
      "Embed fails: event lands in sietch without a vector",
      "Worker backfills vectors, then ships only the contiguous embedded prefix",
      "Watermark advances after ingest; ingest is safe to repeat"
    ] },
    { "dot": "cyan", "title": "Timers", "items": [
      "ENCODING_INTERVAL 5m: sietch to episodic, then GC ended + drained files",
      "ch-api reconciler 30s: closed sessions pooled to L1 through mentat",
      "CONSOLIDATE_HOUR 2: nightly per CONSOLIDATE_WORKSPACES, or POST /v1/semantic/consolidate"
    ] },
    { "dot": "amber", "title": "Who writes what", "items": [
      "ghola daemon: sietch files and the ingest call",
